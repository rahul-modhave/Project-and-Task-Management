# Application configuration
PORT=3000
NODE_ENV=development
APP_SECRET=some-very-secure-random-long-secret-key
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/collabflow

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT configuration
JWT_ACCESS_SECRET=collabflow-access-token-secret-key-12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=collabflow-refresh-token-secret-key-12345
JWT_REFRESH_EXPIRATION=7d

# Email config (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@collabflow.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
